background = #0d0d0d
foreground = #e6dfc8
cursor-color = #e6dfc8
selection-background = #2a2825
selection-foreground = #e6dfc8

palette = 0=#161614
palette = 1=#d9776b
palette = 2=#a3b18a
palette = 3=#e0c98a
palette = 4=#8fa8b8
palette = 5=#b89bb5
palette = 6=#8bb5ad
